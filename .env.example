# Base URL of the PostGramX backend API
VITE_API_BASE_URL=http://localhost:3000

# Run the Telegram Mini App in a normal browser by mocking the Telegram SDK.
# Set to true for local development so the app works outside Telegram.
VITE_TELEGRAM_MOCK=true

# App environment label (local | stage | production)
VITE_ENV_MODE=local

# Log outgoing API requests to the browser console
VITE_API_LOG=false

# Internal payment-retry flag, leave false for normal use
VITE_API_TRIPLE_PAYMENT_REQUESTS=false
